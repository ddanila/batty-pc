# Build / scratch tree --------------------------------------------------
# Ignore everything under build/ by default (compiled EXEs, floppies, probe
# dumps like PROBE_*.txt, per-test scratch dirs build/test_*/, capture
# PPM/PNG/logs, timelines, etc.) and re-include ONLY the intentionally
# tracked data + analysis artifacts below. New test/probe/log scratch under
# build/ is then ignored automatically and never clutters `git status`.
build/*

# Re-include the hand-curated / committed data dirs + analysis outputs:
!build/gt_history/
!build/level_gt/
!build/snapshots/
!build/calls.txt
!build/data_refs.txt
!build/ram_map.txt
!build/ram_smc.txt
!build/reach.txt
!build/regions.blockdef
!build/regions.txt
!build/unknown_branches.txt
!build/unreached_code.txt

# ...but within those re-included dirs, still ignore regenerated scratch:
build/level_gt/_post_tape_boot.sna
build/level_gt/level_*_modded.*
build/level_gt_backup_*/
build/snapshots/*.sna

# Generated asset previews / extracted blobs
assets/font_sheet.png
assets/sprites.bin
assets/random_seed.bin

# Stray index dump from a ZEsarUX capture run
zesarux_index_menu.idx

# Claude Code session files
.claude/
.antigravitycli/

# Python
__pycache__/
*.pyc

# OS junk
.DS_Store
